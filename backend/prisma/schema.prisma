generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  password_hash String         @map("password_hash")
  created_at    DateTime       @default(now()) @map("created_at")
  refresh_tokens RefreshToken[]
  documents     Document[]
  reminders     Reminder[]
  notification_preference NotificationPreferences?

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @map("user_id") @db.Uuid
  token_hash String    @map("token_hash")
  created_at DateTime  @default(now()) @map("created_at")
  expires_at DateTime  @map("expires_at")
  revoked_at DateTime? @map("revoked_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum DocumentStatus {
  uploaded
  processing
  done
  failed
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  user_id    String         @map("user_id") @db.Uuid
  filename   String
  s3_key     String         @map("s3_key")
  status     DocumentStatus @default(uploaded)
  created_at DateTime       @default(now()) @map("created_at")

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  analyses      Analysis[]
  chat_sessions ChatSession[]
  contract_dates ContractDate[]

  @@map("documents")
}

enum ClauseType {
  liability
  termination
  indemnification
  governing_law
  confidentiality
  intellectual_property
  non_compete
  payment
  warranty
  force_majeure
  assignment
  entire_agreement
}

enum RiskLevel {
  low
  medium
  high
}

model Analysis {
  id                 String     @id @default(uuid()) @db.Uuid
  document_id        String     @map("document_id") @db.Uuid
  overall_risk_score Int        @map("overall_risk_score")
  model_version      String     @map("model_version")
  created_at         DateTime   @default(now()) @map("created_at")

  document           Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  clauses            Clause[]

  @@map("analyses")
}

model Clause {
  id             String       @id @default(uuid()) @db.Uuid
  analysis_id    String       @map("analysis_id") @db.Uuid
  clause_type    ClauseType   @map("clause_type")
  risk_level     RiskLevel    @map("risk_level")
  explanation    String       @db.Text
  original_text  String       @map("original_text") @db.Text
  risk_score     Int          @map("risk_score")

  analysis       Analysis     @relation(fields: [analysis_id], references: [id], onDelete: Cascade)
  contract_dates ContractDate[]

  @@map("clauses")
}

model ChatSession {
  id          String    @id @default(uuid()) @db.Uuid
  document_id String    @map("document_id") @db.Uuid
  created_at  DateTime  @default(now()) @map("created_at")

  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  messages    Message[]

  @@map("chat_sessions")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  chat_session_id String      @map("chat_session_id") @db.Uuid
  sender          String      // "user" | "ai"
  content         String      @db.Text
  created_at      DateTime    @default(now()) @map("created_at")

  chat_session    ChatSession @relation(fields: [chat_session_id], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

enum DateType {
  expiry_date
  renewal_date
  notice_deadline
  payment_due
  probation_end
  lock_in_end
  other
}

enum ReminderStatus {
  pending
  sent
  snoozed
  resolved
  failed
}

enum ReminderChannel {
  email
  push
  sms
}

model ContractDate {
  id             String     @id @default(uuid()) @db.Uuid
  doc_id         String     @map("doc_id") @db.Uuid
  date_type      DateType   @map("date_type")
  raw_text       String     @map("raw_text")
  resolved_date  DateTime   @map("resolved_date")
  confidence     Float
  clause_id      String?    @map("clause_id") @db.Uuid
  user_confirmed Boolean    @default(false) @map("user_confirmed")
  is_active      Boolean    @default(true) @map("is_active")
  created_at     DateTime   @default(now()) @map("created_at")

  document  Document   @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  clause    Clause?    @relation(fields: [clause_id], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@map("contract_dates")
}

model Reminder {
  id               String          @id @default(uuid()) @db.Uuid
  user_id          String          @map("user_id") @db.Uuid
  contract_date_id String          @map("contract_date_id") @db.Uuid
  days_before      Int             @map("days_before")
  scheduled_for    DateTime        @map("scheduled_for")
  status           ReminderStatus  @default(pending)
  channel          ReminderChannel @default(email)
  sent_at          DateTime?       @map("sent_at")
  snoozed_until    DateTime?       @map("snoozed_until")
  created_at       DateTime        @default(now()) @map("created_at")

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contract_date ContractDate @relation(fields: [contract_date_id], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model NotificationPreferences {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @unique @map("user_id") @db.Uuid
  email_enabled  Boolean  @default(true) @map("email_enabled")
  push_enabled   Boolean  @default(true) @map("push_enabled")
  sms_enabled    Boolean  @default(false) @map("sms_enabled")
  phone_number   String?  @map("phone_number")
  fcm_token      String?  @map("fcm_token")
  reminder_days  Int[]    @default([30, 7, 1]) @map("reminder_days")
  rescan_notify  Boolean  @default(true) @map("rescan_notify")
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
