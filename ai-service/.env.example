# ===========================================================================
# LegalEase AI/ML Microservice Environment Configuration
# ===========================================================================

# Server Port
PORT=8000
HOST=0.0.0.0

# Fine-tuned or Local Classifier Model Path
# Default: ./models/legalease-clause-classifier (falls back to TF-IDF if not found)
CLASSIFIER_MODEL_PATH=./models/legalease-clause-classifier
USE_LEGAL_BERT=0

# ---------------------------------------------------------------------------
# OpenAI API Credentials (Optional - Falls back to offline mock if absent)
# Get from: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# High-Speed LLM Inference via Groq (Free Tier Available)
# Get from: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Pinecone Vector DB (Optional - Falls back to in-memory search if absent)
# Get from: https://app.pinecone.io
# ---------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=legalease
PINECONE_ENVIRONMENT=us-east-1

# ---------------------------------------------------------------------------
# Redis Cache & BullMQ Queue
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
