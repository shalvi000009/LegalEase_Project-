# ===========================================================================
# LegalEase Frontend Environment Variables
# ===========================================================================

# Backend API URL (Express REST API on port 4000)
VITE_API_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Google OAuth 2.0 Client ID (Optional: For "Sign in with Google")
# Get from: Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Firebase Cloud Messaging Web Push VAPID Public Key (Optional: For Push Reminders)
# Get from: Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
VITE_VAPID_PUBLIC_KEY=your_firebase_vapid_public_key_here
